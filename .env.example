# AI Gate Safety System — Environment Configuration Template
# Copy this file to .env and fill in your values
# Never commit the actual .env file to version control

# ── Server ────────────────────────────────────────────────
PORT=5000
FLASK_DEBUG=false

# ── Database (SQL Server — Windows Authentication) ────────
DB_SERVER=YOUR_SERVER_NAME
DB_NAME=AI_Gate_Safety_DB
DB_DRIVER=ODBC Driver 18 for SQL Server

# ── Security ──────────────────────────────────────────────
# Generate a strong random key for production:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-strong-random-secret-key

# ── Gate Camera RTSP URLs ─────────────────────────────────
# Format: rtsp://username:password@ip_address:port/stream
# Leave empty to configure from the Settings page in dashboard
GATE1_RTSP=
GATE2_RTSP=
GATE3_RTSP=
GATE4_RTSP=

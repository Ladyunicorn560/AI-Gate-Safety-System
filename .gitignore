# ─────────────────────────────────────────────
#  AI Gate Safety System — .gitignore
# ─────────────────────────────────────────────

# ── Environment & Secrets ─────────────────────
.env
.env.*
!.env.example

# ── Python ────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
*.spec
.Python

# ── Virtual Environment ───────────────────────
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/

# ── Pytest / Coverage ─────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ── Jupyter ───────────────────────────────────
.ipynb_checkpoints/

# ── ML Models (large binary files) ───────────
# Keep models/ directory but ignore large .pt files
# Upload them via Git LFS or a model registry instead
*.pt
*.pth
*.onnx
*.tflite
*.pb
*.h5
*.pkl
*.joblib

# ── Logs ──────────────────────────────────────
logs/
*.log

# ── Runtime Data ──────────────────────────────
data/employee_faces/
data/uploads/
data/violations/
data/reports/

# Allow sample/demo files to remain tracked
!data/sample_*.jpg
!data/sample_*.mp4

# ── Database files ────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── OS Artifacts ──────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ── IDE & Editor ──────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
*.suo
*.ntvs*
*.njsproj
*.sln
*.user

# ── Node (if any tooling) ─────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Temporary Files ───────────────────────────
*.tmp
*.bak
*.orig
tmp/
temp/
